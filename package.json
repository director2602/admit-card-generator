{
  "name": "admit-card-generator",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "postinstall": "node scripts/copy-fonts.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "samples": "tsx --env-file-if-exists=.env scripts/make-samples.ts",
    "worker": "tsx --env-file-if-exists=.env scripts/worker.ts",
    "e2e": "tsx --env-file-if-exists=.env scripts/e2e.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1142.0",
    "@fontsource/merriweather": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/noto-sans": "^5.3.0",
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "@fontsource/noto-serif": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.0",
    "archiver": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "bwip-js": "^4.11.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "jose": "^6.2.12",
    "jszip": "^3.10.2",
    "lucide-react": "^1.48.0",
    "next": "16.3.7",
    "papaparse": "^5.7.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0",
    "puppeteer-core": "^25.12.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/archiver": "^8.0.0",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.9"
  }
}